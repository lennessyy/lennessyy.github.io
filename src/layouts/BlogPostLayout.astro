---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { absoluteUrl, pageUrl, person } from '../lib/metadata';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: string;
    tags?: string[];
    narrative?: boolean;
  };
  headings?: Heading[];
}

const { frontmatter, headings = [] } = Astro.props;
const date = new Date(frontmatter.pubDate);
const canonical = pageUrl(Astro.url.pathname, Astro.site);
const markdownUrl = absoluteUrl(`${Astro.url.pathname.replace(/\/+$/, '')}.md`, Astro.site);
const structuredData = {
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  url: canonical,
  mainEntityOfPage: canonical,
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: date.toISOString(),
  author: { '@id': person(Astro.site)['@id'] },
  inLanguage: 'en',
  keywords: frontmatter.tags,
};
---

<BaseLayout title={`${frontmatter.title} — Lenny Chen`} description={frontmatter.description} structuredData={structuredData} markdownUrl={markdownUrl}>
  {!frontmatter.narrative && <TableOfContents headings={headings} />}
  <article>
    <header class="mb-8">
      <h1 class="text-2xl font-bold text-[var(--color-heading)]">{frontmatter.title}</h1>
      <time class="mt-2 block text-sm text-[var(--color-text-secondary)]" datetime={date.toISOString()}>
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <a href={markdownUrl} class="mt-2 inline-block text-sm text-[var(--color-link)] underline">Read as Markdown</a>
      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-2 text-sm text-[var(--color-text-secondary)]">
          {frontmatter.tags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="prose max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
