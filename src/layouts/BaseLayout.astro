---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { absoluteUrl, pageUrl, person, jsonForHtml, siteDescription } from '../lib/metadata';

interface Props {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown>;
  markdownUrl?: string;
}

const { title = 'Lenny Chen', description = siteDescription, structuredData, markdownUrl } = Astro.props;
const canonical = pageUrl(Astro.url.pathname, Astro.site);
const metadata = {
  '@context': 'https://schema.org',
  '@graph': [person(Astro.site), ...(structuredData ? [structuredData] : [])],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Lenny Chen — Blog" href={absoluteUrl('/rss.xml', Astro.site)} />
    <link rel="describedby" type="application/json" title="Content index" href={absoluteUrl('/content.json', Astro.site)} />
    {markdownUrl && <link rel="alternate" type="text/markdown" title="Markdown" href={markdownUrl} />}
    <script is:inline type="application/ld+json" set:html={jsonForHtml(metadata)} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      // Apply theme before paint to avoid flash
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c57f85c4e64f44cc9a9ac0c2118f5b5c"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text)] font-sans antialiased min-h-screen flex flex-col">
    <div class="mx-auto w-full max-w-2xl px-6 flex-1 flex flex-col">
      <Header />
      <main class="py-12 flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
