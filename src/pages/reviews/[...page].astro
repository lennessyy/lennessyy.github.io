---
import BaseLayout from '../../layouts/BaseLayout.astro';
import reviewsData from '../../data/reviews.json';

export function getStaticPaths({ paginate }: { paginate: Function }) {
  return paginate(reviewsData, { pageSize: 10 });
}

const { page } = Astro.props;

function stars(rating: number | null): string {
  if (!rating) return '';
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5;
  return '★'.repeat(full) + (half ? '½' : '');
}

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const searchableReviews = reviewsData.map((review) => ({
  filmTitle: review.filmTitle,
  filmYear: review.filmYear,
  rating: review.rating,
  watchedDate: review.watchedDate,
  reviewText: review.reviewText,
  letterboxdUrl: review.letterboxdUrl,
  slug: review.slug,
  hasLocalReview: Boolean(review.reviewText),
}));
const searchDataJson = JSON.stringify(searchableReviews).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Reviews — Lenny Chen"
  description="Film reviews by Lenny Chen, pulled from Letterboxd."
>
  <h1 class="text-2xl font-bold text-[var(--color-heading)]">Film reviews</h1>
  <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
    Pulled from my <a href="https://letterboxd.com/lennessy/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-link)] hover:text-[var(--color-link-hover)] underline transition-colors">Letterboxd</a>.
  </p>

  <div class="mt-8">
    <div class="flex flex-col gap-3 sm:flex-row">
      <label for="review-search" class="sr-only">Search film reviews</label>
      <input
        id="review-search"
        type="search"
        autocomplete="off"
        placeholder="Search reviews"
        class="min-w-0 flex-1 border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2 font-mono text-sm text-[var(--color-text)] outline-none transition-colors placeholder:text-[var(--color-text-tertiary)] focus:border-[var(--color-accent)]"
      />
      <button
        id="review-roulette-open"
        type="button"
        class="border border-[var(--color-accent)] bg-[var(--color-accent-subtle)] px-4 py-2 font-mono text-sm font-bold text-[var(--color-accent)] transition-colors hover:border-[var(--color-accent-hover)] hover:text-[var(--color-accent-hover)]"
      >
        Review roulette
      </button>
    </div>
    <p id="review-search-count" class="mt-2 hidden text-xs text-[var(--color-text-tertiary)]" aria-live="polite"></p>
  </div>

  <div id="review-search-results" class="mt-6 hidden flex-col"></div>

  <div id="review-roulette" class="mt-8 hidden border-y border-[var(--color-border)] py-6" aria-live="polite">
    <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-accent)]">Review roulette</p>
    <div class="mt-4 min-h-32">
      <p id="roulette-film" class="font-sans text-3xl font-bold leading-none text-[var(--color-heading)] break-words">Ready?</p>
      <p id="roulette-meta" class="mt-3 text-sm text-[var(--color-text-secondary)]">Click randomize and see where you land.</p>
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <button
        id="roulette-spin"
        class="border border-[var(--color-heading)] bg-[var(--color-heading)] px-4 py-2 font-mono text-sm font-bold text-[var(--color-bg)] transition-transform hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-70 disabled:hover:translate-y-0"
        type="button"
      >
        Randomize
      </button>
      <a id="roulette-result-link" class="hidden border border-[var(--color-border)] px-4 py-2 font-mono text-sm font-bold text-[var(--color-heading)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]" href="/reviews">
        Read review
      </a>
      <button
        id="review-roulette-close"
        type="button"
        class="px-0 py-2 font-mono text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-heading)]"
      >
        Back to list
      </button>
    </div>
  </div>

  <div id="review-list" class="mt-8 flex flex-col">
    {page.data.map((r: any) => (
      <a
        href={r.reviewText ? `/reviews/${r.slug}` : r.letterboxdUrl}
        target={r.reviewText ? undefined : '_blank'}
        rel={r.reviewText ? undefined : 'noopener noreferrer'}
        class="group flex items-baseline justify-between gap-4 border-b border-[var(--color-border)] py-3 first:border-t"
      >
        <div class="flex items-baseline gap-2 min-w-0">
          <span class="font-sans font-medium text-[var(--color-heading)] group-hover:text-[var(--color-link)] transition-colors truncate">
            {r.filmTitle}
          </span>
          {r.filmYear && (
            <span class="shrink-0 text-sm text-[var(--color-text-tertiary)]">
              ({r.filmYear})
            </span>
          )}
        </div>
        <div class="shrink-0 flex items-baseline gap-2 text-sm">
          {r.watchedDate && (
            <span class="text-[var(--color-text-tertiary)]">{formatDate(r.watchedDate)}</span>
          )}
          {r.rating && (
            <span class="text-[var(--color-accent)]">{stars(r.rating)}</span>
          )}
        </div>
      </a>
    ))}
  </div>

  {page.lastPage > 1 && (
    <nav id="review-pagination" class="mt-8 flex items-center justify-between text-sm">
      {page.url.prev ? (
        <a href={page.url.prev} class="text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors">
          &larr; Newer
        </a>
      ) : (
        <span />
      )}
      <span class="text-[var(--color-text-tertiary)]">
        Page {page.currentPage} of {page.lastPage}
      </span>
      {page.url.next ? (
        <a href={page.url.next} class="text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors">
          Older &rarr;
        </a>
      ) : (
        <span />
      )}
    </nav>
  )}

  <script type="application/json" id="reviews-search-data" set:html={searchDataJson} />
</BaseLayout>

<script>
  type Review = {
    filmTitle: string;
    filmYear: number | null;
    rating: number | null;
    watchedDate: string;
    reviewText: string;
    letterboxdUrl: string;
    slug: string;
    hasLocalReview: boolean;
  };

  const searchInput = document.getElementById('review-search') as HTMLInputElement | null;
  const searchResults = document.getElementById('review-search-results');
  const searchCount = document.getElementById('review-search-count');
  const reviewList = document.getElementById('review-list');
  const pagination = document.getElementById('review-pagination');
  const reviewsDataEl = document.getElementById('reviews-search-data');
  const rouletteOpen = document.getElementById('review-roulette-open') as HTMLButtonElement | null;
  const roulette = document.getElementById('review-roulette');
  const rouletteClose = document.getElementById('review-roulette-close') as HTMLButtonElement | null;
  const rouletteSpin = document.getElementById('roulette-spin') as HTMLButtonElement | null;
  const rouletteFilm = document.getElementById('roulette-film');
  const rouletteMeta = document.getElementById('roulette-meta');
  const rouletteResultLink = document.getElementById('roulette-result-link') as HTMLAnchorElement | null;

  const reviews: Review[] = reviewsDataEl?.textContent ? JSON.parse(reviewsDataEl.textContent) : [];
  let rouletteRun = 0;
  const resultClasses = [
    'group',
    'flex',
    'items-baseline',
    'justify-between',
    'gap-4',
    'border-b',
    'border-[var(--color-border)]',
    'py-3',
    'first:border-t',
  ];

  function stars(rating: number | null): string {
    if (!rating) return '';
    const full = Math.floor(rating);
    const half = rating % 1 >= 0.5;
    return '★'.repeat(full) + (half ? '½' : '');
  }

  function formatDate(dateStr: string): string {
    const date = new Date(dateStr);
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  function normalize(value: unknown): string {
    return String(value ?? '').toLowerCase();
  }

  function getReviewUrl(review: Review): string {
    return review.hasLocalReview ? `/reviews/${review.slug}` : review.letterboxdUrl;
  }

  function describeReview(review: Review): string {
    const details = [
      review.filmYear ? String(review.filmYear) : '',
      review.rating ? stars(review.rating) : '',
      review.watchedDate ? formatDate(review.watchedDate) : '',
    ].filter(Boolean);

    return details.join(' · ');
  }

  function createReviewLink(review: Review): HTMLAnchorElement {
    const link = document.createElement('a');
    link.href = getReviewUrl(review);
    link.classList.add(...resultClasses);

    if (!review.hasLocalReview) {
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
    }

    const titleWrap = document.createElement('div');
    titleWrap.className = 'flex items-baseline gap-2 min-w-0';

    const title = document.createElement('span');
    title.className = 'font-sans font-medium text-[var(--color-heading)] group-hover:text-[var(--color-link)] transition-colors truncate';
    title.textContent = review.filmTitle;
    titleWrap.append(title);

    if (review.filmYear) {
      const year = document.createElement('span');
      year.className = 'shrink-0 text-sm text-[var(--color-text-tertiary)]';
      year.textContent = `(${review.filmYear})`;
      titleWrap.append(year);
    }

    const meta = document.createElement('div');
    meta.className = 'shrink-0 flex items-baseline gap-2 text-sm';

    if (review.watchedDate) {
      const date = document.createElement('span');
      date.className = 'text-[var(--color-text-tertiary)]';
      date.textContent = formatDate(review.watchedDate);
      meta.append(date);
    }

    if (review.rating) {
      const rating = document.createElement('span');
      rating.className = 'text-[var(--color-accent)]';
      rating.textContent = stars(review.rating);
      meta.append(rating);
    }

    link.append(titleWrap, meta);
    return link;
  }

  function attachBackLinkStorage(root: ParentNode = document) {
    root.querySelectorAll('a[href^="/reviews/"]').forEach((link) => {
      link.addEventListener('click', () => {
        sessionStorage.setItem('reviews-back', window.location.href);
      });
    });
  }

  function updateSearch() {
    if (!searchInput || !searchResults || !searchCount || !reviewList) return;

    const query = searchInput.value.trim().toLowerCase();
    const isSearching = query.length > 0;

    roulette?.classList.add('hidden');
    reviewList.classList.toggle('hidden', isSearching);
    pagination?.classList.toggle('hidden', isSearching);
    searchResults.classList.toggle('hidden', !isSearching);
    searchResults.classList.toggle('flex', isSearching);
    searchCount.classList.toggle('hidden', !isSearching);

    if (!isSearching) {
      searchResults.replaceChildren();
      searchCount.textContent = '';
      return;
    }

    const matches = reviews.filter((review) => {
      const haystack = [
        review.filmTitle,
        review.filmYear,
        review.rating,
        review.watchedDate,
        review.reviewText,
      ].map(normalize).join(' ');

      return haystack.includes(query);
    });

    searchResults.replaceChildren(...matches.map(createReviewLink));
    attachBackLinkStorage(searchResults);

    searchCount.textContent = `${matches.length} ${matches.length === 1 ? 'review' : 'reviews'} found`;

    if (matches.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'border-y border-[var(--color-border)] py-6 text-sm text-[var(--color-text-secondary)]';
      empty.textContent = 'No reviews found.';
      searchResults.append(empty);
    }
  }

  function setRouletteReview(review: Review) {
    if (!rouletteFilm || !rouletteMeta) return;

    rouletteFilm.textContent = review.filmTitle;
    rouletteMeta.textContent = describeReview(review);
  }

  function resetRouletteResult() {
    rouletteResultLink?.classList.add('hidden');

    if (rouletteResultLink) {
      rouletteResultLink.href = '/reviews';
      rouletteResultLink.removeAttribute('target');
      rouletteResultLink.removeAttribute('rel');
    }
  }

  function openRoulette() {
    if (!roulette) return;

    searchInput?.blur();
    if (searchInput) searchInput.value = '';
    searchResults?.replaceChildren();
    searchResults?.classList.add('hidden');
    searchResults?.classList.remove('flex');
    searchCount?.classList.add('hidden');
    if (searchCount) searchCount.textContent = '';
    reviewList?.classList.add('hidden');
    pagination?.classList.add('hidden');
    roulette.classList.remove('hidden');
    resetRouletteResult();
    rouletteRun += 1;
    rouletteSpin?.focus();
  }

  function closeRoulette() {
    if (!roulette) return;

    roulette.classList.add('hidden');
    reviewList?.classList.remove('hidden');
    pagination?.classList.remove('hidden');
    rouletteSpin?.removeAttribute('disabled');
    rouletteRun += 1;
    rouletteOpen?.focus();
  }

  function finishRoulette(review: Review) {
    rouletteSpin?.removeAttribute('disabled');
    setRouletteReview(review);

    if (!rouletteResultLink) return;

    rouletteResultLink.href = getReviewUrl(review);
    rouletteResultLink.classList.remove('hidden');

    if (!review.hasLocalReview) {
      rouletteResultLink.target = '_blank';
      rouletteResultLink.rel = 'noopener noreferrer';
    } else {
      rouletteResultLink.removeAttribute('target');
      rouletteResultLink.removeAttribute('rel');
    }
  }

  function spinRoulette() {
    if (!reviews.length || !rouletteSpin) return;

    resetRouletteResult();
    rouletteSpin.disabled = true;

    rouletteRun += 1;
    const runId = rouletteRun;
    const target = reviews[Math.floor(Math.random() * reviews.length)];
    const steps = 24 + Math.floor(Math.random() * 10);
    let index = 0;

    function tick() {
      if (runId !== rouletteRun) return;

      const isFinalStep = index >= steps;
      const review = isFinalStep
        ? target
        : reviews[Math.floor(Math.random() * reviews.length)];

      setRouletteReview(review);

      if (isFinalStep) {
        finishRoulette(target);
        return;
      }

      index += 1;
      const progress = index / steps;
      const delay = 34 + Math.pow(progress, 2.4) * 210;
      window.setTimeout(tick, delay);
    }

    tick();
  }

  searchInput?.addEventListener('input', updateSearch);
  rouletteOpen?.addEventListener('click', openRoulette);
  rouletteClose?.addEventListener('click', closeRoulette);
  rouletteSpin?.addEventListener('click', spinRoulette);
  rouletteResultLink?.addEventListener('click', () => {
    if (rouletteResultLink.getAttribute('href')?.startsWith('/reviews/')) {
      sessionStorage.setItem('reviews-back', window.location.href);
    }
  });

  attachBackLinkStorage();
</script>
